# Local development only. Docker Compose reads this file after copying to .env.
POSTGRES_DB=counters
POSTGRES_USER=counters
POSTGRES_PASSWORD=counters_local
POSTGRES_DSN=postgres://counters:counters_local@localhost:5432/counters?sslmode=disable
REDIS_ADDR=localhost:6379
HTTP_ADDR=:8080
REQUEST_TIMEOUT=1s
POSTGRES_TIMEOUT=500ms
REDIS_TIMEOUT=100ms
SHUTDOWN_TIMEOUT=10s
