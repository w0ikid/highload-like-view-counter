# Local development only. Docker Compose reads this file after copying to .env.
POSTGRES_DB=counters
POSTGRES_USER=counters
POSTGRES_PASSWORD=counters_local
POSTGRES_DSN=postgres://counters:counters_local@localhost:5432/counters?sslmode=disable
REDIS_ADDR=localhost:6379
HTTP_ADDR=:8080
REQUEST_TIMEOUT=1s
POSTGRES_TIMEOUT=500ms
REDIS_TIMEOUT=100ms
SHUTDOWN_TIMEOUT=10s

# Local development key only; replace for any shared deployment.
JWT_SECRET=local-only-change-this-secret-at-least-32-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
PASSWORD_RESET_TTL=15m
AUTH_TIMEOUT=5s
SMTP_ADDR=localhost:1025
SMTP_TIMEOUT=2s
MAIL_FROM=no-reply@counters.local
PASSWORD_RESET_URL=http://localhost:5173/reset-password
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

GRPC_ADDR=:9090
# Educational benchmark identity only. Use bearer for authenticated clients.
COUNTER_AUTH_MODE=test
REDIS_NAMESPACE=counters
VIEW_TTL=1h
FLUSH_INTERVAL=1s
RECONCILE_INTERVAL=1m
WORKER_BUDGET=5s
