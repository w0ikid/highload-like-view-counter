  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "TestUserID": {
        "type": "apiKey",
        "in": "header",
        "name": "X-User-ID",
        "description": "Only in COUNTER_AUTH_MODE=test; trusted educational identity."
      }
    },
    "schemas": {
      "TokenPair": {
        "type": "object",
        "required": [
          "accessToken",
          "refreshToken",
          "expiresAt"
        ],
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "field": {
            "type": "string",
            "description": "Invalid field, when applicable."
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$",
            "description": "Positive int64 serialized as a decimal string."
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ViewEvent": {
        "type": "object",
        "required": [
          "postId",
          "viewerId"
        ],
        "properties": {
          "postId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "viewerId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          }
        }
      },
      "Counter": {
        "type": "object",
        "required": [
