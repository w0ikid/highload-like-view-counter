          "likes",
          "views",
          "likedByMe"
        ],
        "properties": {
          "postId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "likes": {
            "type": "string"
          },
          "views": {
            "type": "string"
          },
          "likedByMe": {
            "type": "boolean"
          }
        }
      },
      "LikeResponse": {
        "type": "object",
        "properties": {
          "postId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "liked": {
            "type": "boolean"
          }
        }
      },
      "RecordViewsRequest": {
        "type": "object",
        "required": [
          "events"
        ],
        "properties": {
